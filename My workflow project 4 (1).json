        "subject": "Approval Required - Missed Appointment",
        "message": "=\n<p>Dear Manager,</p>\n\n<p>Please review the AI-generated post-discharge check-in message below before it is sent to the patient.</p>\n\n<p><strong>Patient:</strong> {{ $('Get row(s) in sheet').item.json.patientName }}</p>\n\n<p><strong>Patient ID:</strong> {{ $('Get row(s) in sheet').item.json.patientId }}</p>\n\n<p><strong>Diagnosis:</strong> {{ $('Get row(s) in sheet').item.json.diagnosis }}</p>\n\n<p><strong>Discharge Date:</strong> {{ $('Get row(s) in sheet').item.json.dischargeDate }}</p>\n\n<p><strong>Warning Signs:</strong> {{ $('Get row(s) in sheet').item.json.warningSigns }}</p>\n\n<hr>\n\n<p><strong>AI-generated message to be sent to the patient:</strong></p>\n\n<div style=\"background-color: #f1f5f9; padding: 16px; border-left: 4px solid #2563eb; border-radius: 6px; margin: 12px 0;\">\n  <p>{{ $('Message a model').item.json.output[0].content[0].text }}</p>\n</div>\n\n<hr>\n\n<p><strong>Choose your decision:</strong></p>\n\n<p>\n<a href=\"{{ $execution.resumeUrl }}&decision=approve\" style=\"background-color: #198754; color: white; padding: 10px 18px; text-decoration: none; border-radius: 5px;\">\nAPPROVE — Send to patient\n</a>\n</p>\n\n<p>\n<a href=\"{{ $execution.resumeUrl }}&decision=reject\" style=\"background-color: #dc3545; color: white; padding: 10px 18px; text-decoration: none; border-radius: 5px;\">\nREJECT — Do not send\n</a>\n</p>\n\n<p>Thank you.</p>\n",
