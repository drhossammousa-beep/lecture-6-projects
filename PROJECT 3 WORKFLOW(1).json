        "sendTo": "={{ $('Edit Fields').item.json.clinicianEmail }}",
        "subject": "Approval Required - Post-discharge Check-in",
        "message": "=\n<p>Dear Clinician,</p>\n\n<p>Please review the AI-generated post-discharge check-in message below before it is sent to the patient.</p>\n\n<p><strong>Patient:</strong> {{ $('Edit Fields').item.json.patientName }}</p>\n\n<p><strong>Patient ID:</strong> {{ $('Edit Fields').item.json.patientId }}</p>\n\n<p><strong>Diagnosis:</strong> {{ $('Edit Fields').item.json.diagnosis }}</p>\n\n<p><strong>Discharge Date:</strong> {{ $('Edit Fields').item.json.dischargeDate }}</p>\n\n<p><strong>Warning Signs:</strong> {{ $('Edit Fields').item.json.warningSigns }}</p>\n\n<hr>\n\n<p><strong>AI-generated message to be sent to the patient:</strong></p>\n\n<div style=\"background-color:#f1f5f9; border-left:4px solid #2563eb; padding:16px; margin:12px 0; border-radius:4px;\">\n{{ $('Message a model').item.json.output[0].content[0].text }}\n</div>\n\n<hr>\n\n<p><strong>Choose your decision:</strong></p>\n\n<p>\n<a href=\"{{ $execution.resumeUrl }}&decision=approve\"\nstyle=\"display:inline-block; background-color:#198754; color:#ffffff; padding:12px 20px; text-decoration:none; border-radius:5px; font-weight:bold;\">\nAPPROVE — Send to patient\n</a>\n</p>\n\n<p>\n<a href=\"{{ $execution.resumeUrl }}&decision=reject\"\nstyle=\"display:inline-block; background-color:#dc3545; color:#ffffff; padding:12px 20px; text-decoration:none; border-radius:5px; font-weight:bold;\">\nREJECT — Do not send\n</a>\n</p>\n\n<p>Thank you.</p>\n\n<p style=\"color:#777777; font-size:12px;\">\nThis email was generated automatically by n8n.\n</p>\n\n",
        "options": {}
