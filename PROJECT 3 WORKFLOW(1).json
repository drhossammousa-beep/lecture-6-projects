            {
              "content": "=Write one patient check-in SMS using the patient data below.\n\nPatient name: {{ $('Edit Fields').item.json.patientName }}\nClinician name: {{ $('Edit Fields').item.json.clinicianName }}\nDiagnosis: {{ $('Edit Fields').item.json.diagnosis }}\nDischarge date: {{ $('Edit Fields').item.json.dischargeDate }}\nWarning signs: {{ $('Edit Fields').item.json.warningSigns }}\n\nRequirements:\n- Thank the patient for their recent hospital stay.\n- Ask how they are feeling.\n- Remind them to seek medical care if they experience any of the listed warning signs.\n- Keep the entire SMS under 160 characters, including spaces.\n- Use the actual patient name and warning signs.\n- Do not use placeholders.\n- Return only the SMS."
            }
          ]
        },
